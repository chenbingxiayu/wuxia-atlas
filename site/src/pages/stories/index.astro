---
import Base from '../../layouts/Base.astro';
import { B } from '@lib/base';

/* D6：卡片墙构建期从 stories 清单（site/data/stories/*.json）生成——决策 5。
   teaser = 切片实算句（editorial.teaser）；tag = 用户词（关系/成长）；题图 = mini-SVG 缩略。
   新增一篇 = build_stories.py 加配置 + 文案，本页零改动。 */

const mods = import.meta.glob('../../../data/stories/*.json', { eager: true }) as Record<string, any>;
const stories = Object.values(mods)
  .map((m) => m?.default ?? m)
  .filter((d) => d?.story_id)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

/* mini-SVG 缩略：按篇首取主系列（relation→co_events；flow→w 事件人手数；density→total；growth→active） */
const mainKey = (p: any) => (p.chart?.kind === 'relation' ? 'co_events'
  : p.chart?.kind === 'flow' ? 'w' : p.chart?.kind === 'density' ? 'total' : 'active');
const spark = (p: any) => {
  const rows = p.per_chapter;
  const cs = rows.map((r) => r.c);
  const lo = Math.min(...cs), hi = Math.max(...cs);
  const vals = rows.map((r) => r[mainKey(p)] ?? 0);
  const mx = Math.max(...vals, 1);
  const pts = rows.map((r, i) => `${i ? 'L' : 'M'}${(8 + ((r.c - lo) / Math.max(hi - lo, 1)) * 284).toFixed(1)} ${(34 - ((r[mainKey(p)] ?? 0) / mx) * 28).toFixed(1)}`).join('');
  return pts;
};
const color = (p: any) => p.chart?.series?.[0]?.color || '#31536c';
---

<Base title="数据说书">
  <p class="crumb">数据说书</p>
  <h1>数据说书</h1>
  <p class="lead">用图谱证明武侠命题：每篇 = 一句命题、一张可复算的图、一条可对质的证据链。</p>
  <div class="grid">
    {stories.map((s) => (
      <a class="card" href={`${B}stories/${s.story_id}/`}>
        <div class="head"><b>{s.title}</b><span class="tag">{s.tag}</span></div>
        <svg class="spark" viewBox="0 0 300 40" aria-hidden="true">
          <path d={spark(s)} fill="none" stroke={color(s)} stroke-width="1.6" />
        </svg>
        <p>{s.editorial.teaser}</p>
        <span class="fine">已发布 · 引用规范见「关于 · 版权」页 · 可复跑</span>
      </a>
    ))}
  </div>
</Base>
<style>
  .crumb { font-size: .85rem; color: var(--ink-faint); }
  h1 { letter-spacing: 2px; }
  .lead { color: var(--ink-light); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; margin-top: 16px; }
  .card { display: block; border: 1px solid var(--line-strong); border-radius: 4px; padding: 18px 20px;
    background: rgba(255,255,255,.45); color: var(--ink); }
  .card:hover { border-color: var(--seal); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .head b { font-size: 1.1rem; }
  .tag { font-size: .72rem; color: var(--seal); border: 1px solid var(--seal); border-radius: 999px; padding: 0 .6em; white-space: nowrap; }
  .spark { width: 100%; height: 40px; display: block; margin: 10px 0 4px; opacity: .85; }
  .card p { font-size: .9rem; color: var(--ink-light); line-height: 1.8; }
  .fine { font-size: .75rem; color: var(--ink-faint); }
</style>
