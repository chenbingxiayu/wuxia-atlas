---
import Base from '../../layouts/Base.astro';
import { B } from '@lib/base';
import { SCOPE_NOTE } from '@lib/scope';
import booksJson from '@data/books.json';
import dossiersJson from '@data/dossiers.json';
import artsJson from '@data/arts.json';
import weaponsJson from '@data/weapons.json';
import matchesJson from '@data/matches.json';
import universeJson from '@data/universe.json';

/* —— 全部统计与版本日期构建期实算（P0-3），不硬编码：回切全量口径后自动跟随。 —— */
const books = ((booksJson as any).books || []) as Array<Record<string, any>>;
const nBooks = books.length || ((booksJson as any).meta?.totals?.books ?? 0);

/* 深度解析 = kb_status 已点亮的书目（与 universe/intertext 页同一口径）。 */
const litBooks = books.filter((w) => w.kb_status === '已点亮' || w.kb_status === 'lit');
const litNames = litBooks.map((w) => w.book);

const nDossiers = ((dossiersJson as any).dossiers || []).length;
const nArts = (artsJson as any).meta?.totals?.arts ?? ((artsJson as any).arts || []).length;
const nWeapons = ((weaponsJson as any).weapons || []).length;
const nMatches = (matchesJson as any).meta?.totals?.matches ?? ((matchesJson as any).matches || []).length;
const nFighters = (matchesJson as any).meta?.totals?.fighters ?? ((matchesJson as any).fighters || []).length;

const nLines = ((universeJson as any).lines || []).length;
const nSeeds = ((universeJson as any).interchange_seeds || []).length;

/* 作者明示互文：口径与 universe/intertext 页一致——out_refs kind=authorial，双端均为站内已点亮书目。 */
const litSet = new Set(litNames);
const intertextPairs = new Map<string, number>();
for (const w of books) {
  for (const r of w.out_refs || []) {
    if (r?.kind === 'authorial' && litSet.has(w.book) && litSet.has(r.book)) {
      intertextPairs.set(`${w.book}→${r.book}`, r.count || 0);
    }
  }
}
const nIntertextPairs = intertextPairs.size;
const nIntertextLocs = [...intertextPairs.values()].reduce((a, b) => a + b, 0);

/* 数据版本 = 本页引用切片 meta.generated 的最大值（dossiers 带时刻，取日期部 YYYY-MM-DD）。 */
const generatedDates = [booksJson, dossiersJson, artsJson, weaponsJson, matchesJson, universeJson]
  .map((d) => String((d as any)?.meta?.generated ?? ''))
  .filter((s) => /^\d{4}-\d{2}-\d{2}/.test(s))
  .map((s) => s.slice(0, 10))
  .sort();
const version = generatedDates.length ? generatedDates[generatedDates.length - 1] : '';
const versionTitle = version
  ? SCOPE_NOTE
    ? `当前数据版本（${version} · 演示口径：${SCOPE_NOTE}）`
    : `当前数据版本（${version}）`
  : '当前数据版本';
---

<Base title="关于" description="江湖图志：方法论、版权边界与开放数据。">
  <h1>关于 · 江湖图志</h1>
  <p class="lead">
    「江湖图志」是一座<b>生长中的武侠宇宙图集</b>：以梁羽生 {nBooks} 部作品的机器可读知识库为唯一事实源，
    用"标注→实体→事件→关系"管线产出图谱，再由图谱生成站点的每一个页面。
    <b>站点是数据的纯函数</b>——管线每深度解析一部书，图集自动生长一部。
  </p>

  <section>
    <h2>四条立站原则</h2>
    <ol>
      <li><b>可溯源</b>：每个结论挂 <span class="loc">书·回:行</span> 定位符，争论可以"出示原文"；</li>
      <li><b>宇宙性</b>：组织轴心是系列谱系与跨书人物（换乘站），不是孤立词条；</li>
      <li><b>数据先行</b>：凡离开图谱也能做到的（普通百科内容）低优先级；只有图谱才能算的（路径、指纹、评分）才是本站灵魂；</li>
      <li><b>版权分层</b>：图谱层公开（本站全部内容），语料层仅限本地（阅读器），引用三档位由构建期裁剪保证。</li>
    </ol>
  </section>

  <section>
    <h2>{versionTitle}</h2>
    <ul>
      <li>深度解析（{litNames.length} 部）：{litNames.join(' / ')}；</li>
      <li>图谱：{nDossiers} 位人物档案 / {nArts} 门武功 / {nWeapons} 件名物；</li>
      <li>武评：{nMatches} 场明文对局（{nFighters} 名参战者）；</li>
      <li>宇宙层：{nLines} 条系列线路 · 作者明示互文 {nIntertextPairs} 对（{nIntertextLocs} 处）· {nSeeds} 个换乘站。</li>
    </ul>
  </section>

  <section>
    <h2>深入</h2>
    <ul>
      <li><a href={`${B}about/method`}>方法论</a> —— 管线、标注语法、校订闭环、评分口径；</li>
      <li><a href={`${B}about/copyright`}>版权边界</a> —— 图谱层/语料层、引用三档位；</li>
      <li><a href={`${B}about/data`}>开放数据</a> —— 下载与 schema；</li>
      <li><a href={`${B}search`}>搜索</a> —— 全站全文检索。</li>
    </ul>
  </section>
</Base>

<style>
  .lead { color: var(--ink-light); }
  .loc { color: var(--ink-faint); border-bottom: 1px dotted var(--ghost); }
  b { color: var(--seal); }
  li { margin: .3em 0; }
</style>
