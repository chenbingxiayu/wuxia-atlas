---
import Base from '../../layouts/Base.astro';
import sectsJson from '@data/sects.json';
import matchesJson from '@data/matches.json';
import sectSeatsJson from '@data/sect_seats.json';
import { B } from '@lib/base';
import { dsp } from '@lib/display';
import { artTarget, chapterHref, personTarget, sectTarget } from '@lib/links';
import { scrubTierNote, tierLabel } from '@lib/tiers';

export function getStaticPaths() {
  return sectsJson.sects.map((s) => ({ params: { slug: s.canonical }, props: { s } }));
}
const { s } = Astro.props;
const all = sectsJson.sects;
const idx = all.findIndex((x) => x.canonical === s.canonical);
const prevS = all[(idx - 1 + all.length) % all.length];
const nextS = all[(idx + 1) % all.length];

const PRED_ORDER = ['镇山', '拥有', '独门', '传授', '修习'];
/* 镇山单列「镇山绝学」区块（置于武功册之前），原谓词分组不再重复显示 */
const preds = Object.keys(s.arts_by_pred).filter((p) => p !== '镇山').sort((x, y) => {
  const ix = PRED_ORDER.indexOf(x), iy = PRED_ORDER.indexOf(y);
  return (ix < 0 ? 9 : ix) - (iy < 0 ? 9 : iy);
});
/* 功法级 / 招式级分流（用户口径：武功册只列功法，招式归各武功页招式名表） */
const splitArts = (list) => {
  const gongfa = list.filter((a) => a.level !== '招式');
  const moves = list.filter((a) => a.level === '招式');
  return { gongfa, moves };
};
const zsGongfa = (s.arts_by_pred['镇山'] || [])
  .filter((a2) => a2.level !== '招式')
  .map((a2) => ({
    ...a2,
    target: artTarget(a2.art),
    chaps: (a2.locs || []).map((lc) => ({ loc: lc, href: chapterHref(a2.book, lc) })),
  }));
const zsMoves = (s.arts_by_pred['镇山'] || []).filter((a2) => a2.level === '招式');

/* 人物 → 门派（用于恩怨对头的组织级聚合） */
const personSect = new Map();
for (const x of all) for (const m of x.members) if (m.name && !personSect.has(m.name)) personSect.set(m.name, x.canonical);
const memberNames = new Set(s.members.map((m) => m.name));
const foes = new Map();
for (const m of matchesJson.matches) {
  let self = null, other = null;
  if (memberNames.has(m.a)) { self = m.a; other = m.b; }
  else if (memberNames.has(m.b)) { self = m.b; other = m.a; }
  if (!other) continue;
  const osect = personSect.get(other) || '无门派散人';
  if (osect === s.canonical) continue;
  const f = foes.get(osect) || { n: 0, names: new Map() };
  f.n += 1;
  f.names.set(other, (f.names.get(other) || 0) + 1);
  foes.set(osect, f);
}
const foeRows = [...foes.entries()].sort((a, b) => b[1].n - a[1].n).slice(0, 5);

/* 世系成员（工具 B）+ 未入世系的 derived 成员 */
const tenured = new Set();
for (const t of s.tenures || []) for (const m of t.members || []) tenured.add(typeof m === 'string' ? m : m.name);
const restMembers = s.members.filter((m) => !tenured.has(m.name));
// 链接目标解析（task-49）：无页人物/门派/功法 → 纯文本；别名/展示名 → canonical。
const tenureRows = (s.tenures || []).map((t2) => ({
  ...t2,
  leaderTarget: personTarget(t2.leader),
  memberRows: (t2.members || []).map((m) => {
    const name = typeof m === 'string' ? m : m.name;
    return { name, target: personTarget(name) };
  }),
}));
const restMemberRows = restMembers.map((m) => ({ ...m, target: personTarget(m.name) }));
/* 门派驻地小卡：seat 数据的 sect 字段带/不带"派"等尾缀——去尾缀后互含匹配（短核≥2 字防误配），未命中不渲染 */
const stripTail = (n) => String(n || '').replace(/[派帮门寺教]$/, '');
const seatHit = (w: any) => {
  const a = stripTail(w.sect), b = stripTail(s.canonical);
  if (!a || !b) return false;
  const short = a.length <= b.length ? a : b;
  return short.length >= 2 && (a.includes(b) || b.includes(a));
};
const seatRow = (sectSeatsJson.seats || []).find(seatHit) || null;
const pendingRow = (sectSeatsJson.pending || []).find(seatHit) || null;
const foeRowRows = foeRows.map(([osect, f]) => ({ osect, f, target: sectTarget(osect) }));
---

<Base title={s.canonical} description={`${s.canonical}：武功册、掌门世系、成员册与恩怨对头——梁羽生武侠宇宙门派志。`}>
  <p class="crumb"><a href={`${B}sects/`}>门派志</a> / {s.canonical}</p>
  <nav class="sectnav">
    {all.map((x) => (
      <a class={x.canonical === s.canonical ? 'on' : ''} href={`${B}sects/${encodeURIComponent(x.canonical)}/`}>{x.canonical}</a>
    ))}
  </nav>
  <h1>{s.canonical}
    {s.cross_book && <span class="badge badge-cross">跨书</span>}
  </h1>
  <p class="meta">
    <span class="nav2">
      <a href={`${B}sects/${encodeURIComponent(prevS.canonical)}/`}>← 上一派</a>
      <a href={`${B}sects/${encodeURIComponent(nextS.canonical)}/`}>下一派 →</a>
    </span>
  </p>
  <p class="meta">事件参与 <b>{s.ev_total}</b> · 见于 {s.books.map((b: string) => <a class="bookchip" href={`${B}books/${b}/`}>{b}</a>)}</p>
  <p class="meta">事件参与 <b>{s.ev_total}</b> · 见于 {s.books.map((b) => <a class="bookchip" href={`${B}books/${b}/`}>{b}</a>)}</p>

  {(seatRow || pendingRow) && (
    <section>
      <h2>驻地</h2>
      <div class="card" style="padding:12px 22px">
        {seatRow ? (
          <p class="seatline">
            <b>{seatRow.seat}</b>
            <span class="dim">{seatRow.status === '推理' ? '◌ 推理' : '● 实锚'}</span>
            <span class="fine">{seatRow.basis}</span>
          </p>
        ) : (
          <p class="seatline">
            <span class="dim">坐标考订中</span>
            {pendingRow.note && <span class="fine">{pendingRow.note}</span>}
          </p>
        )}
      </div>
    </section>
  )}

  {zsGongfa.length > 0 && (
    <section>
      <h2>镇山绝学 <span class="dim">（本派以此功为镇派武功 · 关系表明文）</span></h2>
      <ul class="zs">
        {zsGongfa.map((z) => (
          <li>
            {z.target
              ? <a class="chip" href={`${B}arts/${encodeURIComponent(z.target)}/`}>{z.art}</a>
              : <span class="chip">{z.art}</span>}
            <span class="loc">{z.book}·{z.chaps.map((c, i) => (
              <>{i > 0 && '，'}{c.href ? <a href={c.href}>{c.loc}</a> : <span>{c.loc}</span>}</>
            ))}</span>
            {z.note && <span class="fine"> {scrubTierNote(z.note)}</span>}
          </li>
        ))}
      </ul>
      {zsMoves.length > 0 && <p class="dim moves-note">另有招式级 {zsMoves.length} 个（{zsMoves.map((m) => m.art).join('、')}）——归各武功页招式名表。</p>}
    </section>
  )}

  {preds.length > 0 && (
    <section>
      <h2>武功册 <span class="dim">（只列功法级；招式见各武功页「招式名表」——招式名表分级）</span></h2>
      {preds.map((pred) => {
        const { gongfa, moves } = splitArts(s.arts_by_pred[pred]);
        if (!gongfa.length) return null;
        return (
          <div>
            <h3 class="sub">{pred}（{gongfa.length}）</h3>
            <p class="chips">
              {gongfa.map((a) => {
                const tg = artTarget(a.art);
                return tg
                  ? <a class="chip" href={`${B}arts/${encodeURIComponent(tg)}/`}>{a.art}<small>·{a.book}{a.ev > 1 ? ` · ${a.ev} 证` : ''}</small></a>
                  : <span class="chip">{a.art}<small>·{a.book}{a.ev > 1 ? ` · ${a.ev} 证` : ''}</small></span>;
              })}
            </p>
            {moves.length > 0 && (
              <p class="dim moves-note">另有招式级 {moves.length} 个（{moves.map((m) => m.art).join('、')}）——归各武功页招式名表，不入门派武功册。</p>
            )}
          </div>
        );
      })}
    </section>
  )}

  {(s.tenures || []).length > 0 ? (
    <section>
      <h2>掌门世系与成员册 <span class="dim">（世系考订 门派世系表 · 每代掌门列门下成员）</span></h2>
      <div class="tenures">
        {tenureRows.map((t) => (
          <div class="tenure">
            <div class="t-head">
              <b>掌门：{t.leaderTarget
                ? <a href={`${B}characters/${encodeURIComponent(t.leaderTarget)}/`}>{dsp(t.leader)}</a>
                : <span>{dsp(t.leader)}</span>}</b>
              <span class="mono dim">{t.period?.from || ''}{t.period?.to ? ` → ${t.period.to}` : ''}</span>
              {t.conf && <span class="badge">{tierLabel(t.conf)}</span>}
              {t.successor && <span class="dim">继任：{dsp(t.successor)}</span>}
            </div>
            {(t.members || []).length > 0 ? (
              <p class="chips">
                <span class="dim">门下：</span>
                {t.memberRows.map((m) => (
                  m.target
                    ? <a class="chip" href={`${B}characters/${encodeURIComponent(m.target)}/`}>{dsp(m.name)}</a>
                    : <span class="chip">{dsp(m.name)}</span>
                ))}
              </p>
            ) : (
              <p class="dim">门下成员待考订归组（成员归组考订中）。</p>
            )}
            <ul class="notes">
              {(t.evidence || []).map((e) => (
                <li><span class="loc">{e.book}·{e.loc}</span> <span class="dim">{e.kind}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {(s.lineage_gaps || []).length > 0 && (
        <ul class="notes">
          {s.lineage_gaps.map((g) => <li class="dim">缺口：{g.before || ''} {g.note}</li>)}
        </ul>
      )}
      {(s.lineage_todo || []).length > 0 && (
        <p class="dim">待考：{(s.lineage_todo || []).map((t: any) => typeof t === 'string' ? t : `${t.name || ''}（${t.book || ''}·${t.loc || ''}·${t.kind || ''}）`).join('；')}</p>
      )}
    </section>
  ) : null}

  {restMembers.length > 0 && (
    <section>
      <h2>其余成员 <span class="dim">（旁证：强证/确证级门派线索，未入世系分组）</span></h2>
      <p class="chips">
        {restMemberRows.map((m) => (
          m.target ? (
            <a class="chip" href={`${B}characters/${encodeURIComponent(m.target)}/`}>
              {dsp(m.name)}<small>{m.tier === 'strong' ? '强证' : '确证'} · 经{m.via.slice(0, 2).join('、')}</small>
            </a>
          ) : (
            <span class="chip">{dsp(m.name)}<small>{m.tier === 'strong' ? '强证' : '确证'} · 经{m.via.slice(0, 2).join('、')}</small></span>
          )
        ))}
      </p>
    </section>
  )}

  {foeRows.length > 0 && (
    <section>
      <h2>恩怨对头 <span class="dim">（对局事件 · 本派成员交手对象的门派聚合）</span></h2>
      <p class="chips">
        {foeRowRows.map(({ osect, f, target }) => (
          target
            ? <a class="chip" href={`${B}sects/${encodeURIComponent(target)}/`}>{osect}<small>{f.n} 场</small></a>
            : <span class="chip">{osect}<small>{f.n} 场</small></span>
        ))}
      </p>
      <p class="dim">交手最多：{[...foeRows[0][1].names.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3).map(([n, c]) => `${dsp(n)}×${c}`).join('、')}（详见各人对局详情页）。</p>
    </section>
  )}
</Base>

<style>
  .crumb { font-size: .85rem; color: var(--ink-faint); }
  .meta { color: var(--ink-light); }
  .meta b { color: var(--azure); }
  h1 { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .nav2 { font-size: .8rem; font-weight: 400; }
  .nav2 a { color: var(--azure); margin-left: 8px; }
  .sectnav { display: flex; flex-wrap: wrap; gap: 2px; margin-top: .6em; font-size: .82rem; }
  .sectnav a { padding: .15em .6em; border-radius: 999px; color: var(--ink-faint); border: 1px solid transparent; }
  .sectnav a:hover { color: var(--seal); }
  .sectnav a.on { color: var(--seal); border-color: var(--seal); font-weight: 700; }
  .bookchip { display: inline-block; border: 1px solid var(--line-strong); border-radius: 999px;
    padding: .02em .6em; margin: 0 .2em; font-size: .85rem; }
  .chip { display: inline-block; border: 1px solid var(--line-strong); border-radius: 999px;
    padding: .06em .7em; margin: .15em .2em; font-size: .88rem; background: rgba(255,255,255,.5); color: var(--ink); }
  .chip small { color: var(--ink-faint); margin-left: .3em; font-family: var(--font-mono); }
  a.chip:hover { border-color: var(--seal); color: var(--seal); }
  .chips { line-height: 2.3; }
  .dim { color: var(--ink-faint); font-weight: 400; }
  .sub { font-size: .92rem; color: var(--ink-light); margin: .5em 0 .1em; }
  .notes { font-size: .85rem; padding-left: 1.2em; }
  .notes li { margin: .3em 0; }
  .loc { color: var(--ink-faint); font-family: var(--font-mono); font-size: .85em; }
  .loc a { color: var(--azure); }
  .fine { color: var(--ink-faint); font-size: .8rem; }
  .zs { list-style: none; padding: 0; font-size: .9rem; }
  .zs li { margin: .35em 0; }
  .zs li .chip { margin-right: .5em; }
  .seatline { margin: 0; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .mono { font-family: var(--font-mono); }
  .moves-note { font-size: .8rem; margin: .2em 0 .6em; }
  .tenures { border-left: 2px solid var(--line-strong); margin-top: 10px; }
  .tenure { padding: 8px 0 8px 16px; position: relative; }
  .tenure::before { content: ''; position: absolute; left: -6px; top: 14px; width: 9px; height: 9px;
    border-radius: 50%; background: var(--seal); border: 2px solid #fbf8ef; box-shadow: 0 0 0 1.5px var(--seal); }
  .t-head { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .t-head b { font-size: 1rem; }
  .t-head a { color: var(--azure); }
  .badge { display: inline-block; border: 1px solid var(--ink-faint); border-radius: 3px; padding: 0 6px; font-size: .72rem; }
  section { margin-top: var(--space-5); }
</style>
