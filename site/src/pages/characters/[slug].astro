---
import Base from '../../layouts/Base.astro';
import dossiersJson from '@data/dossiers.json';
import ratingsJson from '@data/ratings.json';
import weaponsJson from '@data/weapons.json';
import charPlotsJson from '@data/char_plots.json';
import charRelationsJson from '@data/char_relations.json';
import chinaGeo from '@data/china-simplified.json';
import { B } from '@lib/base';
import { dsp } from '@lib/display';
import { artTarget, bookTarget, chapterHref, personTarget, sectTarget, weaponTarget } from '@lib/links';
import { isGroupLabel, filterOutGroups } from '@lib/groups';
import { TIER_LABEL, tierClass } from '@lib/tiers';

export function getStaticPaths() {
  return dossiersJson.dossiers.map((d) => ({ params: { slug: d.canonical }, props: { d } }));
}
const { d } = Astro.props;
// 展示层（B-1/B-2）：标题/面包屑/正文人名用 display；URL slug 与链接参数保持 canonical。
const disp = d.display_name || d.display || dsp(d.canonical);
const player = ratingsJson.players.find((p2) => p2.name === d.canonical) || null;
const oppRaw = player ? ((d.combat || {}).top_opponents || [])[0] : null;
const rivalName = oppRaw ? (typeof oppRaw === 'string' ? oppRaw : oppRaw.name || oppRaw.person || oppRaw.c || null) : null;
// 别名展示（B-1/B-2）：别名统一过 display 层并去掉与当前页 display/规范名重复项
// （如 玄烨 页别名表里的「康熙」「玄烨」不再重复出现；URL/内部 key 仍用 canonical）。
const aliasShown: { alias: string; count: number }[] = [];
{
  const seenAlias = new Set<string>([disp]);
  for (const a of d.aliases) {
    const n = dsp(a.alias);
    if (n && !seenAlias.has(n)) { seenAlias.add(n); aliasShown.push({ alias: n, count: a.count }); }
  }
}

// 链接目标解析（task-49）：display/别名/无页实体 → canonical 或纯文本；URL 一律 canonical。
// 行经书 chips（T13/A8）：已点亮书 → 书页链接；未点亮书 → 纯文本 chip（不静默丢弃）
const bookChips = d.books.map((b) => ({ book: b, target: bookTarget(b) }));
const sectAff = d.sect_affinity
  .filter((sa) => sa.tier !== 'weak')
  .map((s) => ({ ...s, target: sectTarget(s.sect) }));
// 定位符（"书·CCC:LLL" 合串）→ 回目页 URL；无章页返回 null（纯文本降级）
const locHrefOf = (s: unknown): string | null => {
  const str = typeof s === 'string' ? s : '';
  const i = str.indexOf('·');
  return i > 0 ? chapterHref(str.slice(0, i), str.slice(i + 1)) : null;
};
const masters = d.lineage.masters.map((m) => ({ ...m, target: personTarget(m.person), href: locHrefOf(m.locs?.[0]) }));
const disciples = d.lineage.disciples.map((m) => ({ ...m, target: personTarget(m.person), href: locHrefOf(m.locs?.[0]) }));
const artRows = d.arts.map((a) => ({ ...a, target: artTarget(a.art) }));
const opponents = filterOutGroups(d.combat.top_opponents, (o) => o.person)
  .map((o) => ({ ...o, target: personTarget(o.person) }));

const CONF = { high: '●●', medium: '●○', low: '○○' };
const maxBar = Math.max(
  ...Object.values(d.chapter_curves).flatMap((c) => Object.values(c)), 1,
);
// spec 002 T4：神兵持物（weapons holders 反查）与关键剧情（锚点轨切片）
const heldWeapons = (weaponsJson as any).weapons
  .filter((w: any) => weaponTarget(w.canonical) && (w.holders || []).some((h: any) => h.name === d.canonical))
  .map((w: any) => ({ canonical: w.canonical, kind: w.kind, grade: w.grade, target: weaponTarget(w.canonical) }));
const plots = (charPlotsJson as any).characters?.[d.canonical]?.plots || [];
// PlotMap（spec 004 T3）：构建期 SVG——底图简化省界 + 锚点（实锚●/推理◌）+ 编年虚线
const china = (chinaGeo as any);
const pj = china.proj;
const proj = (lng: number, lat: number): [number, number] =>
  [pj.ox + (lng - pj.L0) * pj.KX * pj.scale, pj.oy + (pj.T - lat) * pj.scale];
const mapPts = plots.filter((p: any) => p.place?.coords);
// 人物关系（spec 003 T5）：情缘/亲缘/仇敌/恩义分组；师承沿用 lineage 不入
const relGroups = ((charRelationsJson as any).relations || [])
  .filter((r: any) => r.a === d.canonical || r.b === d.canonical)
  .map((r: any) => {
    const other = r.a === d.canonical ? r.b : r.a;
    return { type: r.type, tier: r.tier, book: r.book, loc: r.loc, other, otherTarget: personTarget(other) };
  });
---

<Base title={disp} description={`${disp}：别名、师承传人、武功、战绩、出场曲线——梁羽生武侠宇宙人物档案。`}>
  <p class="crumb"><a href={`${B}characters/`}>人物谱</a> / {disp}</p>
  <h1>
    {disp}
    {d.cross_book && <span class="badge badge-cross" title="行经多部作品">跨书人物</span>}
  </h1>
  <p class="meta">
    出场 <b>{d.appearance_total.toLocaleString()}</b> 次 ·
    行经 {bookChips.map(({ book, target }) => (
      target
        ? <a class="bookchip" href={`${B}books/${target}/`}>{book}</a>
        : <span class="bookchip" title="该书暂无专页">{book}</span>
    ))}
  </p>

  {aliasShown.length > 0 && (
    <p class="meta">
      别名：{aliasShown.map((a) => <span class="chip">{a.alias}<small>×{a.count}</small></span>)}
    </p>
  )}

  <section class="card note">
    <b>人物志</b> <span class="badge badge-todo">待撰写 · 编辑流程</span>
    <p class="dim">摘要文案走"LLM 以本档案为上下文草拟 → 人工校定"流程后填入；本页其余各卡均为图谱自动事实。</p>
  </section>

  {plots.length > 0 && (
    <section>
      <h2>关键剧情 <span class="dim">（考订锚点 · 按故事先后）</span></h2>
      <ol class="plots">
        {plots.map((p: any, i: number) => (
          <li>
            <b style={`color:${p.tag_colors?.[0] || '#8c8477'}`}>{i + 1}</b>
            <b class="pname">{p.name}</b>
            {p.line && <span class="dim"> — {p.line}</span>}
            {chapterHref(p.book, p.loc) && <a class="loc loc-link" href={chapterHref(p.book, p.loc)}>{p.book}·{p.loc} →</a>}
          </li>
        ))}
      </ol>
      <p class="fine">锚点来自剧情考订轨；地名与纪年补齐后接入剧情地图。</p>
    </section>
  )}

  {mapPts.length >= 2 && (
    <section>
      <h2>关键剧情地图 <span class="dim">（点=锚点 · 颜色示类型 · 编号示先后 · 虚线=故事先后，不表示行进路线）</span></h2>
      <div class="mapcard">
        <svg viewBox={`0 0 ${china.W} ${china.H}`} style="width:100%;height:auto;display:block" role="img" aria-label={`${disp} 关键剧情地图`}>
          <path d={china.d} fill="#f1e9d7" stroke="#c9bda2" stroke-width="1.2"/>
          {mapPts.map((p: any, i: number) => {
            const [x, y] = proj(p.place.coords[0], p.place.coords[1]);
            const c = p.tag_colors?.[0] || '#8c8477';
            const reasoned = p.place.status === '推理';
            const prev = i > 0 ? mapPts[i - 1].place.coords : null;
            const [px, py] = prev ? proj(prev[0], prev[1]) : [0, 0];
            return (
              <g>
                {prev && <line x1={px} y1={py} x2={x} y2={y} stroke="#8c8477" stroke-width="1.3" stroke-dasharray="4 4" opacity=".6"/>}
                <circle cx={x} cy={y} r={reasoned ? 9 : 8}
                  fill={reasoned ? 'none' : c} stroke={c} stroke-width="2"
                  stroke-dasharray={reasoned ? '3 3' : undefined}>
                  <title>{`${i + 1} ${p.name} · ${p.place.status}${p.place.name ? ' · ' + p.place.name : ''}`}</title>
                </circle>
                <text x={x} y={y - 14} font-size="12" text-anchor="middle" font-weight="700" fill={c}>{i + 1}</text>
              </g>
            );
          })}
        </svg>
        <div class="lab" style="padding:6px 10px">
          图例：<b>● 实锚</b>（原文明文）· <b>◌ 推理偏移</b>（依附近实锚，依据见剧情列表）· 待考锚点仅入列表不上图 ·
          底图 DataV 省界简化投影
        </div>
      </div>
    </section>
  )}

  {relGroups.length > 0 && (
    <section>
      <h2>人物关系 <span class="dim">（情缘 / 亲缘 / 仇敌 / 恩义 · 每条挂定位）</span></h2>
      <p class="chips">
        {relGroups.map((r) => (
          r.otherTarget ? (
            <a class="chip" href={`${B}characters/${encodeURIComponent(r.otherTarget)}/`}>
              {r.type} · {r.otherTarget}
              <small>{r.tier === 'strong' ? '强证' : '考订'} · {r.book}·{r.loc}</small>
            </a>
          ) : (
            <span class="chip">{r.type} · {r.other}<small>{r.book}·{r.loc}</small></span>
          )
        ))}
      </p>
    </section>
  )}

  {sectAff.length > 0 && (
    <section>
      <h2>门派线索 <span class="dim">（仅强证/确证级 · 推测级已排除——反用某派武功不构成归属）</span></h2>
      <p class="chips">
        {sectAff.map((s) => (
          s.target ? (
            <a class:list={['chip', tierClass(s.tier)]} href={`${B}sects/${encodeURIComponent(s.target)}/`}>
              {s.sect}
              <small>{TIER_LABEL[s.tier]}{s.tier === 'strong' ? '·镇山' : ''}</small>
            </a>
          ) : (
            <span class:list={['chip', tierClass(s.tier)]}>
              {s.sect}
              <small>{TIER_LABEL[s.tier]}{s.tier === 'strong' ? '·镇山' : ''}</small>
            </span>
          )
        ))}
      </p>
    </section>
  )}

  {(masters.length > 0 || disciples.length > 0 || d.ranks.length > 0) && (
    <section>
      <h2>师承 · 传人 · 册立</h2>
      {masters.length > 0 && (
        <p class="chips">
          <span class="dim">师承：</span>
          {masters.map((m) => (
            m.target ? (
              <a class="chip" href={`${B}characters/${encodeURIComponent(m.target)}/`}>
                {dsp(m.person)}<small>{m.tier === 'weak' ? '点拨' : '传授'} · {m.locs[0]}</small>
              </a>
            ) : (
              <span class="chip">
                {dsp(m.person)}<small>{m.tier === 'weak' ? '点拨' : '传授'} · {m.locs[0]}</small>
              </span>
            )
          ))}
        </p>
      )}
      {disciples.length > 0 && (
        <p class="chips">
          <span class="dim">传人：</span>
          {disciples.map((m) => (
            m.target ? (
              <a class="chip" href={`${B}characters/${encodeURIComponent(m.target)}/`}>
                {dsp(m.person)}<small>{m.tier === 'weak' ? '点拨' : '传授'} · {m.locs[0]}</small>
              </a>
            ) : (
              <span class="chip">
                {dsp(m.person)}<small>{m.tier === 'weak' ? '点拨' : '传授'} · {m.locs[0]}</small>
              </span>
            )
          ))}
        </p>
      )}
      {d.ranks.length > 0 && (
        <p class="chips">
          <span class="dim">册立：</span>
          {d.ranks.map((r) => (
            <span class="chip">{dsp(r.person)}<small>{r.records.map((x) => x.verb).join('/')} · {r.records[0].book}·{r.records[0].loc}</small></span>
          ))}
        </p>
      )}
      <p class="fine">分级：传授/拜师/收徒=强证；指点/演示=点拨（不算正式师承）。定位符可回查原书。</p>
    </section>
  )}

  {artRows.length > 0 && (
    <section>
      <h2>武功</h2>
      <p class="chips">
        {artRows.map((a) => (
          a.target ? (
            <a class="chip" href={`${B}arts/${encodeURIComponent(a.target)}/`}>
              {a.art}<small>{a.predicates.join('/')}</small>
            </a>
          ) : (
            <span class="chip">{a.art}<small>{a.predicates.join('/')}</small></span>
          )
        ))}
      </p>
    </section>
  )}

  {heldWeapons.length > 0 && (
    <section>
      <h2>神兵持物 <span class="dim">（曾持有或借用的名物）</span></h2>
      <p class="chips">
        {heldWeapons.map((w) => (
          w.target ? (
            <a class="chip" href={`${B}weapons/${encodeURIComponent(w.target)}/`}>
              {w.canonical}<small>{w.kind}{w.grade ? ` · ${w.grade}` : ''}</small>
            </a>
          ) : (
            <span class="chip">{w.canonical}<small>{w.kind}</small></span>
          )
        ))}
      </p>
    </section>
  )}

  <section>
    <h2>战绩 <span class="dim">（杀伤 / 被杀 / 擒获 / 被擒 · 群目已滤）</span></h2>
    <div class="combat">
      {(['kills', 'slain_by', 'captures', 'captured_by'] as const).map((k) => {
        const LABEL = { kills: '杀伤', slain_by: '被杀', captures: '擒获', captured_by: '被擒' };
        const rows = filterOutGroups(d.combat[k], (x) => x.person);
        if (rows.length === 0) return null;
        return (
          <div>
            <h3 class="sub">{LABEL[k]}（{rows.reduce((s, x) => s + x.records.length, 0)}）</h3>
            <p class="chips">
              {rows.map((x) => {
                const href = chapterHref(x.records[0].book, x.records[0].loc);
                return (
                  <span class="chip">
                    {dsp(x.person)}<small>×{x.records.length} · </small>
                    {href
                      ? <a class="loc loc-link" href={href}>{x.records[0].book}·{x.records[0].loc}</a>
                      : <small class="loc">{x.records[0].book}·{x.records[0].loc}</small>}
                  </span>
                );
              })}
            </p>
          </div>
        );
      })}
    </div>
    {opponents.length > 0 && (
      <p class="chips">
        <span class="dim">高频对手：</span>
        {opponents.map((o) => (
          o.target ? (
            <a class="chip" href={`${B}characters/${encodeURIComponent(o.target)}/`}>
              {dsp(o.person)}<small>×{o.n}</small>
            </a>
          ) : (
            <span class="chip">{dsp(o.person)}<small>×{o.n}</small></span>
          )
        ))}
      </p>
    )}
  </section>

  <section>
    <h2>出场曲线 <span class="dim">（逐回出现次数，含对话提及）</span></h2>
    {Object.entries(d.chapter_curves).map(([book, curve]) => {
      const entries = Object.entries(curve);
      const W = entries.length * 12 + 16;
      return (
        <div class="curve">
          <h3 class="sub">{book}</h3>
          <svg viewBox={`0 0 ${W} 44`} class="bars">
            {entries.map(([chn, n], i) => {
              const h = Math.max(2, Math.round((n / maxBar) * 30));
              const bar = (
                <rect x={8 + i * 12} y={34 - h} width="9" height={h} fill="var(--azure)">
                  <title>{`第 ${chn} 回 · ${n} 次${chapterHref(book, chn) ? ' · 点击进入回目页' : ''}`}</title>
                </rect>
              );
              return chapterHref(book, chn) ? <a href={chapterHref(book, chn)}>{bar}</a> : bar;
            })}
          </svg>
        </div>
      );
    })}
  </section>

  {d.key_events.length > 0 && (
    <section>
      <h2>关键事件 <span class="dim">（high 置信 · 前 12）</span></h2>
      <ul class="stream">
        {d.key_events.map((e) => (
          <li>
            <span class="who">{dsp(e.subject)}</span>
            <span class="verb">{e.verb}</span>
            <span class="who">{dsp(e.object)}</span>
            <span class="conf">{CONF[e.confidence] ?? ''}</span>
            {chapterHref(e.book, e.loc)
              ? <a class="loc loc-link" href={chapterHref(e.book, e.loc)}>{e.book}·{e.loc} →</a>
              : <span class="loc">{e.book}·{e.loc}</span>}
          </li>
        ))}
      </ul>
      <p class="fine">更多对局与互动可从"高频对手"进入对方档案交叉浏览。</p>
    </section>
  )}

  {player ? (
    <section class="card rating-card">
      <div class="rc-head">
        <b>武评</b>
        <span class="rc-rating mono">{player.rating} <small>±{player.rd}</small></span>
        <span class="rc-tier" style={`color:${player.tier === '绝顶' ? '#b8860b' : player.tier === '超一流' ? '#a23527' : player.tier === '一流' ? '#31536c' : '#5f584b'}`}>{player.tier}</span>
      </div>
      <p class="dim">
        生涯对局 {player.matches_n} 场（{player['w/d/l'][0]} 胜 {player['w/d/l'][1]} 平 {player['w/d/l'][2]} 负）
        {player.rd > 150 && <span class="few">数据不足（区间宽）</span>}
      </p>
      {player.curve && player.curve.length >= 2 && (() => {
        const pts = player.curve;
        const CW = 520, CH = 70, padX = 8, padY = 16;
        const rMin = Math.min(...pts.map((c: any) => c.r)), rMax = Math.max(...pts.map((c: any) => c.r));
        const range = Math.max(rMax - rMin, 1);
        const x = (i: number) => padX + (i / (pts.length - 1)) * (CW - 2 * padX);
        const y = (r: number) => CH - padY - ((r - rMin) / range) * (CH - 2 * padY);
        const line = pts.map((c: any, i: number) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(c.r).toFixed(1)}`).join('');
        const peakIdx = pts.reduce((mi: number, c: any, i: number) => c.r > pts[mi].r ? i : mi, 0);
        return (
          <svg class="rc-curve" viewBox={`0 0 ${CW} ${CH}`} style="width:100%;max-width:460px;height:auto;display:block;margin:4px 0" role="img" aria-label="武评巅峰曲线">
            <path d={line} fill="none" stroke="var(--azure)" stroke-width="1.8"/>
            <circle cx={x(peakIdx)} cy={y(pts[peakIdx].r)} r="4.5" fill="var(--gold)"/>
            <text x={x(peakIdx) + 8} y={y(pts[peakIdx].r) - 6} font-size="10" fill="#8a6607">巅峰 {pts[peakIdx].r}</text>
            <text x={padX} y={CH - 2} font-size="9" fill="#8c8477" font-family="monospace">{pts[0].t}</text>
            <text x={CW - padX} y={CH - 2} font-size="9" fill="#8c8477" text-anchor="end" font-family="monospace">{pts[pts.length - 1].t}</text>
          </svg>
        );
      })()}
      <p class="dim links">
        <a href={`${B}ratings/`}>武评总榜 →</a>
        {rivalName && <a href={`${B}ratings/versus/?a=${encodeURIComponent(d.canonical)}&b=${encodeURIComponent(rivalName)}`}>对主要对手 →</a>}
        <a href={`${B}ratings/method/`}>口径 →</a>
      </p>
      <p class="fine">娱乐性指数：仅基于原著交手记录（明文裁决），可到总榜展开证据链对质。</p>
    </section>
  ) : (
    <section class="card note">
      <b>武评</b> <span class="badge badge-todo">无对局记录</span>
      <p class="dim">事件层没有 TA 的胜负词明文裁决——评分维持先验 1500，不入榜。口径见 <a href={`${B}ratings/method/`}>武评方法论</a>。</p>
    </section>
  )}
</Base>

<style>
  .rating-card { border-left: 4px solid var(--seal); }
  .rc-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .rc-rating { font-size: 1.5rem; color: var(--seal); }
  .rc-rating small { color: var(--ink-faint); font-size: .85rem; }
  .rc-tier { display: inline-block; border: 1.5px solid currentColor; border-radius: 3px; padding: 0 8px; font-size: .8rem; transform: rotate(-1.5deg); }
  .few { margin-left: 6px; font-size: 11px; color: #8a6607; border: 1px dashed #8a6607; border-radius: 3px; padding: 0 4px; }
  .links a { margin-right: 14px; color: var(--azure); font-size: .85rem; }
  .crumb { font-size: .85rem; color: var(--ink-faint); }
  .meta { color: var(--ink-light); }
  .meta b { color: var(--azure); }
  .bookchip {
    display: inline-block; border: 1px solid var(--line-strong);
    border-radius: 999px; padding: .02em .6em; margin: 0 .2em; font-size: .85rem;
  }
  .chip {
    display: inline-block; border: 1px solid var(--line-strong);
    border-radius: 999px; padding: .06em .7em; margin: .15em .2em;
    font-size: .88rem; background: rgba(255,255,255,.5); color: var(--ink);
  }
  .chip small { color: var(--ink-faint); margin-left: .3em; font-family: var(--font-mono); }
  a.chip:hover { border-color: var(--seal); color: var(--seal); }
  .chips { line-height: 2.3; }
  .dim { color: var(--ink-faint); font-weight: 400; }
  .fine { font-size: .8rem; color: var(--ink-faint); }
  .sub { font-size: .92rem; color: var(--ink-light); margin: .4em 0 .1em; }
  /* 门派线索档位配色（lib/tiers.ts TIER_CLASS：t-hi=强证 · t-mid=确证 · t-lo=线索） */
