---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import weaponsJson from '@data/weapons.json';
import { B } from '@lib/base';
import { dsp, dspText } from '@lib/display';
import { personTarget, chapterHref } from '@lib/links';
import { tierLabel } from '@lib/tiers';

export function getStaticPaths() {
  return weaponsJson.weapons.map((x) => ({ params: { slug: x.canonical }, props: { x } }));
}
const { x } = Astro.props;
const books = Object.keys(x.books);
/* D5 rev17（名物页重构设计 §六）：chain 已按宇宙编年重排 + 去重（×n）+ 毁噪声证伪。
   主线 = 未折叠 strong 边（铸边编年首段保留在主线）；suspect 毁边折叠进「疑似误伤」区。 */
const strongEdges = x.chain.filter((e) => e.conf === 'strong');
const suspectEdges = strongEdges.filter((e) => e.suspect);
const forgeEdges = strongEdges.filter((e) => e.verb === '铸');
const mainEdges = strongEdges.filter((e) => !e.suspect);
const sideEv = x.chain.filter((e) => e.conf !== 'strong');
const VERB: Record<string, string> = { 夺: '夺', 赠: '赠', 还: '还', 传: '传', 借: '借', 毁: '毁', 失: '失', 铸: '铸', 交战侧证: '证' };
/* D17b（名物流转方向化落地）：dir.who 恒两人（施者/受者，kb/校订/名物流转方向.tsv 校定层）
   时按「from → kind → to」式样渲染（名物页重构设计 §5.6 主线方向化样式）；铸（who=主语）
   维持「X 铸 →」、借维持「借（暂借）」现状。 */
const PAIR_KINDS = new Set(['夺', '赠', '传', '还']);
const hasForge = (x.makers || []).length > 0 || forgeEdges.length > 0;
/* 薄名物（名物页重构设计 §5.2：无铸记录且无 strong 流转链）→ 头部后加条目说明条 */
const isThin = !hasForge && strongEdges.length === 0;
/* 状态徽章（总体方案 §3.3：h1「考订进行中」改 StatusBadge）：auto=考订中，reviewed=深度解析 */
const badgeStatus = x.status === 'reviewed' ? '深度解析' : '考订中';
---

<Base title={x.canonical} description={`${x.canonical}（${x.kind}）：品阶、铸造来历、历代持有人流转链与证据定位符。`}>
  <p class="crumb"><a href={`${B}weapons/`}>神兵谱</a> / {x.canonical}</p>
  <h1 style="font-size:36px;margin:6px 0 8px;letter-spacing:3px">{x.canonical}
    {x.grade && (
      <span class="g">{x.grade} · {x.grade_basis === '明文' ? '明文' : '待考'}</span>
    )}
    <span class="kind">{x.kind}</span>
    {books.length > 1 && <span class="cross">跨书</span>}
    <StatusBadge status={badgeStatus} />
  </h1>
  <p class="meta">
    流转 <b>{mainEdges.length}</b> 段 · 证据 {x.ev_total} 处 · 见于
    {books.map((b) => <a class="bookchip" href={`${B}books/${b}/`}>{b}</a>)}
  </p>

  {isThin && <EmptyState variant="记载简略" />}

  {hasForge && (
    <div class="card forge">
      <b class="forge-label">来历</b>
      <span class="forge-body">
        {(x.makers || []).length > 0 && <>铸造／炼制：
          {x.makers.map((m) => {
            const tg = personTarget(m.name);
            return tg
              ? <a class="chip" href={`${B}characters/${encodeURIComponent(tg)}/`}>{dsp(m.name)}</a>
              : <span class="chip">{dsp(m.name)}</span>;
          })}
          <span class="forge-dir mono">铸 →</span>
        </>}
        {forgeEdges.map((e) => (
          <span class="mono loc">{e.book}·{e.loc}</span>
        ))}
      </span>
    </div>
  )}

  {(mainEdges.length > 0 || suspectEdges.length > 0) && (
    <>
      <h2 class="sec">历代流转 <span class="dim2">编年排序 · 每次易手挂定位符；「借」= 暂借，不计入持有人</span></h2>
      <div class="card tlwrap">
        {mainEdges.length > 0 && (
          <div class="tl">
            {mainEdges.map((e) => {
              const who = e.dir?.who || [];
              const rest = who.length ? e.persons.filter((p: string) => !who.includes(p)) : e.persons;
              const pair = !!e.dir && who.length === 2 && PAIR_KINDS.has(e.dir.kind);
              const link = (p: string) => {
                const tg = personTarget(p);
                return tg
                  ? <a href={`${B}characters/${encodeURIComponent(tg)}/`}>{dsp(p)}</a>
                  : <span>{dsp(p)}</span>;
              };
              return (
                <div class="trow">
                  <div class="tedge">
                    {pair ? (
                      <>
                        <span class="tholder">{link(who[0])}</span>
                        <span class="tarrow">→</span>
                        <span class="tverb">{e.dir.kind}</span>
                        <span class="tarrow">→</span>
                        <span class="tholder">{link(who[1])}</span>
                        {rest.length > 0 && <span class="tholder trest">{rest.map((p: string) => link(p))}</span>}
                      </>
                    ) : e.dir ? (
                      <>
                        <span class="tholder">{who.map((p: string) => link(p))}</span>
                        <span class="tverb" style={e.dir.kind === '借' ? 'color:#8a8172;border-color:#8a8172' : ''}>
                          {e.dir.kind === '铸' ? '铸 →' : '借（暂借）'}
                        </span>
                        {rest.length > 0 && <span class="tholder trest">{rest.map((p: string) => link(p))}</span>}
                      </>
                    ) : (
                      <>
                        <span class="tverb" style={e.verb === '借' ? 'color:#8a8172;border-color:#8a8172' : ''}>{VERB[e.verb] ?? e.verb}{e.verb === '借' ? '（暂借）' : ''}</span>
                        <span class="tholder">{e.persons.map((p: string) => link(p))}</span>
                      </>
                    )}
                    {e.n > 1 && <span class="tn" title={`完全重复边合并 ×${e.n}`}>×{e.n}</span>}
                    {e.subject_low && <span class="tlow" title="毁句主语非该物高频持有人，存疑待裁定">存疑 · 主语非高频持有人</span>}
                    <span class="tconf">{tierLabel(e.conf)}</span>
                    <span class="tloc mono">{e.book}·{e.loc}</span>
                  </div>
                </div>
              );
            })}
          </div>
        )}
        {suspectEdges.length > 0 && (
          <details class="suspect-fold">
            <summary>疑似误伤 {suspectEdges.length} 条（「毁」字句但该物此后仍在传世）<span class="dim2">展开细看</span></summary>
            <ul class="suspect-list">
              {suspectEdges.map((e) => (
                <li>
                  <span class="tverb sverbdim">{VERB[e.verb] ?? e.verb}</span>
                  <span class="spersons">{e.persons.map((p: string) => dsp(p)).join('、')}</span>
                  <span class="loc mono">{e.book}·{e.loc}</span>
                </li>
              ))}
            </ul>
            <p class="fine">以上「毁」字句的编年序位置之后，原著仍有此物的持有/出场记载——是否误伤待人工裁定，故不进主线。</p>
          </details>
        )}
        {mainEdges.length > 0 && <p class="fine" style="margin:8px 12px 4px">边序 = 故事编年（宇宙书序·回号）；×n = 完全重复边合并；跨书段断点显式标注（gaps）。</p>}
      </div>
    </>
  )}

  {x.end_state && Object.keys(x.end_state).length > 0 && (
    <>
      <h2 class="sec">最终归宿 <span class="dim2">毁 / 失明文或末回持有记载</span></h2>
      <div class="card endstate">
        {x.end_state.note && <p class="end-note">{dspText(x.end_state.note)}</p>}
        {Object.entries(x.end_state).filter(([k]) => k !== 'note').map(([k, v]) => (
          <p class="end-extra"><span class="dim">{k}</span>：{String(v)}</p>
        ))}
      </div>
    </>
  )}

  {sideEv.length > 0 && (
    <h2 class="sec">交战 / 事件侧证 <span class="dim2">同回 ▲◈ 事件（确证档）</span></h2>
  )}
  {sideEv.length > 0 && (
    <div class="card" style="padding:10px 24px">
      <ul class="ev">
        {sideEv.slice(0, 8).map((e) => (
          <li><span class="who">{e.persons.map((p) => dsp(p)).join(' × ')}</span><span class="loc mono">{e.book}·{e.loc}</span></li>
        ))}
      </ul>
    </div>
  )}

  <h2 class="sec">相关人物 <span class="dim2">持有人为主 · 借用单列（暂借 ≠ 持有）</span></h2>
  <p class="chipsrow">
    <span class="dim">持有人：</span>
    {(x.holders || []).map((h) => {
      const tg = personTarget(h.name);
      {/* D10：holders 考订补录（kb/校订/神兵表-补录.tsv 校定行）——n=0 不伪造频次，
          以「考订补录」注替代 ×n，悬停显依据定位（名物页重构设计 §相关人物）。 */}
      const tag = h.sup
        ? <small class="sup-tag" title={`考订补录 · ${h.sup.book}·${h.sup.loc}`}>考订补录</small>
        : <small>×{h.n}</small>;
      return tg
        ? <a class="chip" href={`${B}characters/${encodeURIComponent(tg)}/`}>{dsp(h.name)}{tag}</a>
        : <span class="chip">{dsp(h.name)}{tag}</span>;
    })}
    {(x.holders || []).length === 0 && <span class="dim">—</span>}
  </p>
  {(x.holders || []).some((h) => h.sup) && (
    <p class="meta dim">「考订补录」= kb/校订/神兵表-补录.tsv 人工校定行（持有人明文另挂定位，频次不计）。</p>
  )}
  {(x.borrowers || []).length > 0 && (
    <p class="chipsrow">
      <span class="dim">借用 / 暂持：</span>
      {x.borrowers.map((b2) => <span class="chip dashed">{dsp(b2.name)}<small>×{b2.n}</small></span>)}
    </p>
  )}
  {(x.aliases || []).length > 0 && <p class="meta">别名/变体：{x.aliases.map((a) => <span class="chip">{a}</span>)}</p>}

  <h2 class="sec">证据与考订注记</h2>
  <div class="card" style="padding:8px 24px">
    <ul class="ev">
      {x.evidence.slice(0, 12).map((e) => {
        const href = chapterHref(e.book, e.loc);
        return (
          <li>
            <span class="pred">{e.kind}</span>
            {href
              ? <a class="loc mono" href={href}>{e.book}·{e.loc}</a>
              : <span class="loc mono">{e.book}·{e.loc}</span>}
          </li>
        );
      })}
      {x.ev_total > 12 && (
        <li class="dim"><span>…共 {x.ev_total} 处，完整考订表随开放数据提供（见<a href={`${B}about/data/`}>「关于 · 数据」</a>页）</span></li>
      )}
    </ul>
  </div>
</Base>

<style>
  .crumb { font-size: .85rem; color: var(--ink-faint); }
  .crumb a { color: var(--azure); }
  h1 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .g { display: inline-block; border: 1.5px solid #a23527; background: #a23527; color: #fbf8ef;
    border-radius: 3px; padding: 0 8px; font-size: 12.5px; transform: rotate(-1.5deg); white-space: nowrap; }
  .kind { display: inline-block; border: 1.5px solid #31536c; color: #31536c; border-radius: 3px;
    padding: 1px 9px; font-size: 13px; transform: rotate(1.5deg); }
  .cross { display: inline-block; border: 1.5px solid #a23527; color: #a23527; border-radius: 3px;
    padding: 1px 9px; font-size: 13px; transform: rotate(-1deg); }
  .meta { color: var(--ink-light); }
  .meta b { color: #a23527; }
  .meta code { background: rgba(0,0,0,.05); border-radius: 3px; padding: 0 .3em; font-family: var(--font-mono); font-size: .85em; }
  .bookchip { display: inline-block; border: 1px solid var(--line-strong); border-radius: 999px;
    padding: .02em .6em; margin: 0 .2em; font-size: .85rem; }
  .forge { margin-top: 20px; border-left: 4px solid #b8860b; padding: 12px 20px;
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .forge-label { font-family: 'Ma Shan Zheng', serif; font-weight: 400; font-size: 18px; color: #b8860b; white-space: nowrap; }
  .forge-body { font-size: 15px; display: inline-flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .sec { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 900; margin: 36px 0 14px; }
  .sec:after { content: ''; flex: 1; height: 1px; background: #b5a687; }
  .dim2 { color: var(--ink-faint); font-weight: 400; font-size: 14px; }
  .tlwrap { padding: 16px 24px 8px; }
  .tl { position: relative; padding-left: 30px; }
  .tl:before { content: ''; position: absolute; left: 10px; top: 14px; bottom: 14px; width: 2px; background: #d8cdb4; }
  .trow { position: relative; padding: 8px 0; }
  .trow:before { content: ''; position: absolute; left: -25px; top: 15px; width: 11px; height: 11px;
    border-radius: 50%; background: #a23527; border: 2.5px solid #fbf8ef; box-shadow: 0 0 0 1.5px #a23527; }
  .tedge { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .tverb { color: #a23527; border: 1px solid #a23527; border-radius: 3px; padding: 0 8px; font-weight: 700; font-size: 12.5px; }
  .tholder { font-size: 15px; font-weight: 700; display: inline-flex; gap: 8px; }
  .tholder a { color: #31536c; }
  .tholder a:hover { color: #a23527; }
  .tconf { font-size: 11px; color: #8a8172; border: 1px dashed #b5a687; border-radius: 3px; padding: 0 6px; }
  .tloc { margin-left: auto; color: #8a8172; font-size: 11.5px; white-space: nowrap; }
  .mono { font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; }
  .chipsrow { margin: 6px 0 0; line-height: 2.5; }
  .chip { display: inline-block; border: 1px solid var(--line-strong); border-radius: 999px;
    padding: 2px 12px; font-size: 13.5px; background: #fbf8ef; margin: 3px; }
  .chip.dashed { border-style: dashed; color: #8a8172; }
  .chip small { color: #8a8172; margin-left: 4px; font-family: ui-monospace, monospace; }
  /* D10：holders 考订补录注（n=0 不伪造频次；悬停 title 显依据定位） */
  .chip .sup-tag { color: #a2782a; margin-left: 4px; }
  a.chip:hover { border-color: #a23527; color: #a23527; }
  .ev { list-style: none; padding: 0; margin: 0; font-size: 14px; }
  .ev li { padding: 6px 2px; border-bottom: 1px solid #e6ddc8; display: flex; gap: 10px; align-items: baseline; }
  .pred { color: #a23527; margin-right: 10px; font-weight: 600; }
  .who { font-weight: 700; }
  .loc { color: #8a8172; font-size: 12px; }
  .dim { color: #8a8172; }
  .endstate { border-left: 4px solid #31536c; padding: 12px 24px; }
  .end-note { margin: 0; font-size: 15px; }
  .end-extra { margin: 6px 0 0; font-size: 13.5px; color: var(--ink-light); }
  .ev a.loc { text-decoration: underline; text-underline-offset: 3px; }
  .ev a.loc:hover { color: #a23527; }
  section { margin-top: 30px; }
  /* —— D5 rev17：方向化 / 去重 ×n / 主语存疑 / 疑似误伤折叠 —— */
  .forge-dir { color: #b8860b; font-size: 13px; margin-left: 2px; }
  /* —— D17b：夺/赠/传/还双元素方向边「from → kind → to」（§5.6 主线方向化样式） —— */
  .tarrow { color: #b5a687; font-size: 14px; flex: none; }
  .tn { display: inline-block; border: 1px dashed #a23527; color: #a23527; border-radius: 3px;
    padding: 0 6px; font-size: 11.5px; font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; }
  .tlow { display: inline-block; color: #8a6d3b; font-size: 11.5px; border-bottom: 1px dotted #8a6d3b; }
  .trest { color: var(--ink-light); font-weight: 400; }
  .suspect-fold { margin: 10px 12px 8px; border: 1px dashed #b5a687; border-radius: 4px;
    background: rgba(138, 109, 59, .05); }
  .suspect-fold summary { cursor: pointer; padding: 8px 14px; font-size: 14px; font-weight: 700;
    color: #8a6d3b; list-style: revert; }
  .suspect-fold summary .dim2 { font-weight: 400; margin-left: 6px; }
  .suspect-list { list-style: none; padding: 2px 16px 6px; margin: 0; font-size: 13.5px; }
  .suspect-list li { display: flex; gap: 10px; align-items: baseline; padding: 5px 0;
    border-top: 1px solid #e6ddc8; }
  .sverbdim { color: #8a6d3b; border-color: #8a6d3b; flex: none; }
  .spersons { color: var(--ink-light); }
  .suspect-fold .fine { margin: 0 16px 10px; color: #8a8172; font-size: 12.5px; }
</style>
