---
import Base from '../../layouts/Base.astro';
import weaponsJson from '@data/weapons.json';
import { B } from '@lib/base';

const w = weaponsJson.weapons;
const t = weaponsJson.meta.totals;
const CATS = ['剑', '刀', '暗器', '奇门', '护甲', '宝物'];
const catOf = (x) => (CATS.includes(x.kind) ? x.kind : '宝物');
const byCat = new Map(CATS.map((c) => [c, []]));
for (const x of w) byCat.get(catOf(x)).push(x);
for (const [c] of byCat) byCat.get(c).sort((a, b) => b.count - a.count);
const cross = w.filter((x) => Object.keys(x.books).length > 1).length;
const strongEdges = t.chain_strong;
---

<Base title="神兵谱" description="梁羽生武侠宇宙名物谱：神兵品阶、历代持有人流转链，每次易手都挂原著定位符。">
  <p class="crumb">名物谱 / 神兵（M7 · 工具 C 接数）</p>
  <h1>神兵谱</h1>
  <p class="lead">
    `•` 兵器/宝物实体 <b>{t.entities}</b>（四书实测）→ 专名性归层后入谱名物 <b>{t.名物}</b>
    （凡物 {t.凡物} · 药材 {t.药材} 归丹药谱原料层）· 明文流转边 <b>{strongEdges}</b>（赠/夺/还/传/借/毁/失 句式直证）。
    品阶徽章：<span class="badge solid">明文</span> = 语料直证"神兵/宝剑/利器"；
    <span class="badge dashed">推断</span> = 待人工考订（品阶不设推断，宁缺毋滥）。
  </p>
  <p class="lead cats">
    {CATS.map((c) => <a href={`#${c}`}>{c}<small>{byCat.get(c).length}</small></a>)}
    <span class="fine">跨书流转 {cross} 件 · 考订 TSV：kb/校订/神兵表-考订.tsv</span>
  </p>

  {CATS.map((c) => (
    byCat.get(c).length > 0 && (
      <section>
        <h2 id={c}>{c}<small>{byCat.get(c).length} 件</small></h2>
        <div class="grid">
          {byCat.get(c).map((x) => (
            <a class="card" href={`${B}weapons/${encodeURIComponent(x.canonical)}/`}>
              <div class="head">
                <b>{x.canonical}</b>
                {x.grade && <span class={x.grade_basis === '明文' ? 'badge solid' : 'badge dashed'}>{x.grade}</span>}
                <span class="kind">{x.kind}</span>
              </div>
              <div class="chain">
                {x.chain.filter((e) => e.conf === 'strong').slice(0, 4).map((e) => (
                  <span class="edge"><i>{e.verb}</i>{e.persons.join('+')}</span>
                ))}
                {x.chain.filter((e) => e.conf === 'strong').length === 0 && <span class="none">共现证据 {x.ev_total} 处</span>}
              </div>
              <div class="foot">
                <span>{Object.keys(x.books).length > 1 ? `跨书 ${Object.keys(x.books).length}` : Object.keys(x.books)[0]}</span>
                <span>证据 {x.ev_total}</span>
                <span class={x.conf}>{x.conf}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  ))}

  <section>
    <h2>数据口径</h2>
    <p class="lead">
      底表 <code>kb/神兵表.json</code>（考订工具 C，v3 架构：稳定键 = 名物规范名）·
      归层三判：专名性（主）/ 明文品阶（副）/ 药材词表（转层）·
      流转边 = 明文句式（赠/夺/还/传/借/毁/失）＞ 同回 ▲/◈ 事件侧证（ok）＞ 共现（weak 不入链）。
      本页仅展示 strong / ok 档；扩展表（秘籍谱 `[`×`☆` 配对、丹药谱毒↔解药、权柄谱职衔）随工具 C 逐张开。
    </p>
  </section>
</Base>

<style>
  .crumb { font-size: .85rem; color: var(--ink-faint); }
  h1 { letter-spacing: 2px; }
  .lead { color: var(--ink-light); line-height: 1.9; }
  .lead b { color: var(--seal); }
  .lead code { background: rgba(0,0,0,.05); border-radius: 3px; padding: 0 .3em; font-family: var(--font-mono); font-size: .85em; }
  .badge { display: inline-block; border: 1.5px solid var(--seal); background: var(--seal); color: #fbf8ef;
    border-radius: 3px; padding: 0 .45em; font-size: .72rem; transform: rotate(-1.5deg); }
  .badge.dashed { background: transparent; border-style: dashed; color: #8a6607; }
  .cats a { margin-right: 12px; color: var(--azure); }
  .cats a:hover { color: var(--seal); }
  .cats small { color: var(--ink-faint); margin-left: 2px; }
  .fine { color: var(--ink-faint); font-size: .8rem; margin-left: auto; }
  section { margin-top: var(--space-5); }
  h2 { border-bottom: 1px solid var(--line); padding-bottom: .2em; }
  h2 small { font-weight: 400; font-size: .8rem; color: var(--ink-faint); margin-left: .6em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 12px; }
  .card { display: block; border: 1px solid var(--line-strong); border-radius: 4px; padding: 12px 14px;
    background: rgba(255,255,255,.45); color: var(--ink); }
  .card:hover { border-color: var(--seal); }
  .head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .head b { font-size: 1.05rem; letter-spacing: 1px; }
  .kind { margin-left: auto; font-size: .75rem; color: var(--ink-light); border: 1px solid var(--line-strong); border-radius: 999px; padding: 0 .6em; }
  .chain { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px; font-size: .78rem; }
  .edge { border: 1px solid var(--line); border-radius: 3px; padding: 0 .4em; color: var(--ink-light); }
  .edge i { font-style: normal; color: var(--seal); margin-right: .3em; }
  .none { color: var(--ink-faint); }
  .foot { margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--line); display: flex; gap: 12px; font-size: .75rem; color: var(--ink-faint); }
  .foot .strong { color: var(--seal); }
  .foot .ok { color: #8a6607; }
  .foot .weak { color: var(--ink-faint); }
</style>
