---
import Base from '../../layouts/Base.astro';
import artsJson from '@data/arts.json';

const byCat = new Map();
for (const a of artsJson.arts) {
  if (!byCat.has(a.category)) byCat.set(a.category, []);
  byCat.get(a.category).push(a);
}
const cats = [...byCat.entries()].sort((x, y) => y[1].length - x[1].length);
---

<Base title="武功谱" description="梁羽生武侠宇宙武功谱：品类、门派归属、修习者、传承——全部带定位符。">
  <h1>武功谱 <span class="badge badge-lit">已上线</span></h1>
  <p class="lead">
    已点亮书目中出现在关系考订里的 <b>{artsJson.meta.totals.arts}</b> 门武功
    （跨书 {artsJson.meta.totals.cross_book} 门），按品类分组。
    品类由名称后缀规则自动判定；证据计数=关系条目证据数。
  </p>

  {cats.map(([cat, arts]) => (
    <section>
      <h2>{cat} <span class="dim">（{arts.length}）</span></h2>
      <p class="chips">
        {arts.map((a) => (
          <a class={`chip ${a.cross_book ? 'cross' : ''}`} href={`/arts/${encodeURIComponent(a.canonical)}/`}>
            {a.canonical}<small>·{a.ev_total}</small>
          </a>
        ))}
      </p>
    </section>
  ))}
  <p class="fine">全书目 ☆ 实体中另有未进入关系考订者，随新书面作自动并入。</p>
</Base>

<style>
  .lead { color: var(--ink-light); }
  .chips { line-height: 2.3; }
  .chip {
    display: inline-block; border: 1px solid var(--line-strong);
    border-radius: 999px; padding: .06em .7em; margin: .15em .2em;
    font-size: .88rem; background: rgba(255,255,255,.5); color: var(--ink);
  }
  .chip.cross { border-color: var(--seal); }
  .chip small { color: var(--ink-faint); font-family: var(--font-mono); }
  a.chip:hover { border-color: var(--seal); color: var(--seal); }
  .dim { color: var(--ink-faint); font-weight: 400; }
  .fine { font-size: .8rem; color: var(--ink-faint); }
  section { margin-top: var(--space-4); }
  h2 { margin-bottom: var(--space-1); }
</style>
