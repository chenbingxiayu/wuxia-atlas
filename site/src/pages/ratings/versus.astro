---
import Base from '../../layouts/Base.astro';
import VersusTool from '../../islands/VersusTool';
---
<Base title="对局详情">
  <p class="crumb"><a href="../">侠谱总榜</a> / 对局详情（单页 + URL 参数，486 对不生成静态页）</p>
  <h1>对局详情</h1>
  <p class="lead">评分对比 · 历史交锋 · 预期胜率——每一场都挂「书·回」定位符，点开即对质。</p>
  <VersusTool client:load />
</Base>
<style>
  .crumb { font-size: .85rem; color: var(--ink-faint); }
  .crumb a { color: var(--azure); }
  h1 { letter-spacing: 2px; }
  .lead { color: var(--ink-light); }
</style>
